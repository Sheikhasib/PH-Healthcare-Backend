model Payment {
  id String @id @default(uuid())

  status PaymentStatus @default(UNPAID)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("BDT")

  paymentGateway        String @default("bKash")
  merchantInvoiceNumber String @unique // appointment id

  bKashPaymentId String? @unique
  bKashTrxId     String?
  payerReference String? // user phone or email
  paidAt         String? // payment time

  gatwayResponse Json? // bKash response

  refundTrxId  String?
  refundAmount Decimal? @db.Decimal(10, 2)
  refundReason String?
  refundAt     String? // refund time

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}
